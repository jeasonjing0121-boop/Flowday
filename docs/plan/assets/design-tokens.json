    "work": { "label": "工作", "light": "#4A5B8C", "dark": "#8798C9" },
    "study": { "label": "学习", "light": "#2F7477", "dark": "#6BA9A9" },
    "life": { "label": "生活", "light": "#B0724A", "dark": "#D19A76" },
    "health": { "label": "健康", "light": "#5F7F3F", "dark": "#9DB77A" },
