    "amber": { "400": "#FFB877", "500": "#F2A45C" },
    "rose": { "500": "#E07FA6", "600": "#C9668F", "700": "#8A4E73" },
    "violet": { "500": "#7C7DE0", "600": "#5B5CBF" }
  },

  "semantic": {
    "light": {
      "bg": { "canvas": "#FAF7F2", "surface": "#FFFEFC", "sunken": "#F2EDE4", "raised": "#FFFFFF", "hover": "#F3EFE8", "selected": "#EDE8E0", "inverse": "#1C1A17", "scrim": "rgba(28,26,23,0.32)" },
      "border": { "subtle": "#EDE7DC", "default": "#E2DACD", "strong": "#CFC5B4", "focus": "#46508F" },
      "text": { "primary": "#1C1A17", "secondary": "#5A544C", "tertiary": "#6E665A", "disabled": "#B3AA9C", "inverse": "#FAF7F2" },
      "accent": { "default": "#46508F", "hover": "#3A437F", "subtle": "#EDEEF7" },
      "action": { "primaryBg": "#1C1A17", "primaryHover": "#2E2A25", "primaryText": "#FAF7F2" },
      "status": {
        "success": { "fg": "#2C6E4F", "bg": "#E9F1EA" },
        "warning": { "fg": "#8A5A0B", "bg": "#FBF0DC" },
        "danger": { "fg": "#A93327", "bg": "#F9E7E4" },
        "info": { "fg": "#2D5E80", "bg": "#E7F0F5" }
      }
    },
    "dark": {
      "bg": { "canvas": "#121318", "surface": "#1A1B22", "sunken": "#0E0F13", "raised": "#23242C", "hover": "#24252D", "selected": "#2C2D37", "inverse": "#F2EFE9", "scrim": "rgba(0,0,0,0.56)" },
      "border": { "subtle": "#24252D", "default": "#2F3038", "strong": "#41424C", "focus": "#8B93E8" },
      "text": { "primary": "#F2EFE9", "secondary": "#B9B4AC", "tertiary": "#8D887F", "disabled": "#5C5852", "inverse": "#121318" },
      "accent": { "default": "#8B93E8", "hover": "#A6ACF0", "subtle": "#232438" },
      "action": { "primaryBg": "#F2EFE9", "primaryHover": "#FFFFFF", "primaryText": "#121318" },
      "status": {
        "success": { "fg": "#6FBF95", "bg": "#1B2A22" },
        "warning": { "fg": "#E0B15C", "bg": "#2A2317" },
        "danger": { "fg": "#F08070", "bg": "#2C1D1B" },
        "info": { "fg": "#7FB3D0", "bg": "#182630" }
      }
    }
  },

  "ai": {
    "gradient": {
      "light": "linear-gradient(135deg, #F2A45C 0%, #C9668F 52%, #5B5CBF 100%)",
      "dark": "linear-gradient(135deg, #FFB877 0%, #E07FA6 52%, #7C7DE0 100%)",
      "softLight": "linear-gradient(135deg, rgba(242,164,92,0.10) 0%, rgba(201,102,143,0.10) 52%, rgba(91,92,191,0.10) 100%)",
      "softDark": "linear-gradient(135deg, rgba(255,184,119,0.12) 0%, rgba(224,127,166,0.12) 52%, rgba(124,125,224,0.12) 100%)",
      "angle": "135deg"
    },
    "ink": { "light": "#8A4E73", "dark": "#E07FA6" },
    "glow": "0 0 0 1px rgba(201,102,143,0.18), 0 8px 24px -12px rgba(91,92,191,0.25)",
    "maxScreenArea": "8%"
  },

  "priority": {
    "P1": { "label": "紧急", "light": "#B93C2E", "dark": "#FF7A6B" },
    "P2": { "label": "高", "light": "#965C0A", "dark": "#E0A44A" },
    "P3": { "label": "普通", "light": "#2F6C8C", "dark": "#6FA8CC" },
    "P4": { "label": "低", "light": "#6F675C", "dark": "#9A948B" }
  },

