{
  "$schemaVersion": "0.2.0",
  "meta": {
    "name": "FlowDay Design Tokens",
    "theme": "Dawn Paper (light default) + Night Flight (dark)",
    "sourceOfTruth": "flowday/docs/plan/02-design-system.md",
    "updatedAt": "2026-11-13",
    "note": "Components MUST reference semantic tokens only. Primitive values are for the semantic layer."
  },

  "primitive": {
    "paper": { "50": "#FAF7F2", "0": "#FFFEFC", "100": "#F3EFE8", "200": "#F2EDE4", "300": "#EDE7DC", "400": "#E2DACD", "500": "#CFC5B4", "white": "#FFFFFF" },
    "ink": { "900": "#1C1A17", "800": "#2E2A25", "700": "#5A544C", "500": "#6E665A", "300": "#B3AA9C", "100": "#FAF7F2" },
    "indigo": { "600": "#46508F", "700": "#3A437F", "50": "#EDEEF7", "300": "#8B93E8", "950": "#232438" },
    "night": { "950": "#0E0F13", "900": "#121318", "850": "#1A1B22", "800": "#23242C", "700": "#2C2D37", "600": "#2F3038", "500": "#41424C", "400": "#5C5852" },
