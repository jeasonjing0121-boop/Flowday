  "space": { "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },

  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 12, "2xl": 16, "full": 999 },

  "border": { "width": 1, "widthFocus": 2, "widthAiAccent": 1.5 },

  "shadow": {
    "light": {
      "card": "0 1px 2px rgba(28,26,23,0.04)",
      "popover": "0 8px 24px -8px rgba(28,26,23,0.16), 0 1px 2px rgba(28,26,23,0.06)",
      "modal": "0 24px 64px -16px rgba(28,26,23,0.24)",
      "lift": "0 12px 28px -10px rgba(28,26,23,0.22)"
    },
    "dark": {
      "card": "inset 0 1px 0 rgba(255,255,255,0.04)",
      "popover": "0 8px 24px -12px rgba(0,0,0,0.8)",
      "modal": "0 24px 64px -16px rgba(0,0,0,0.9)",
      "lift": "0 12px 28px -10px rgba(0,0,0,0.85)"
    }
  },

  "breakpoint": { "xs": 360, "sm": 480, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1440 },

  "zIndex": { "base": 0, "sticky": 10, "chrome": 20, "float": 30, "popover": 40, "tooltip": 50, "command": 60, "modal": 70, "toast": 80, "drag": 90 },

  "motion": {
    "duration": { "instant": 80, "fast": 120, "base": 180, "moderate": 240, "slow": 320, "chart": 600 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.36, 0.64, 1)"
    },
    "reducedMotion": { "duration": "0.01ms", "keep": ["opacity"] }
  },

