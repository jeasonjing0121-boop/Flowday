    "family": { "label": "家庭", "light": "#7A5E8C", "dark": "#A48BC0" },
    "other": { "label": "其他", "light": "#6E6A64", "dark": "#A09A92" },
    "tintRule": "color-mix(in srgb, {color} 12%, var(--fd-bg-surface)) for light; 16% for dark"
