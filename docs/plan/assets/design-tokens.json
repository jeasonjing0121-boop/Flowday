      "body": { "desktop": 14, "mobile": 15, "lineHeight": 1.65, "weight": 400, "letterSpacing": "0" },
      "body-sm": { "desktop": 13, "mobile": 14, "lineHeight": 1.55, "weight": 400, "letterSpacing": "0" },
